{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "externalBin": [
      "binaries/ohmyagent"
    ],
    "resources": {
      "../browser-extension/dist": "browser-extension",
      "../plugins/skills": "skills"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ],
        "section": "devel"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "recommends": [
          "libappindicator-gtk3",
          "gstreamer1-plugins-good",
          "gstreamer1-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://release.monkeycode-ai.com/public/desktop/latest-linux.json"
      ]
    }
  }
}
