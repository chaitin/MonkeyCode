---
import BaseLayout from '../../layouts/BaseLayout.astro';
import hugeicons from '@iconify-json/hugeicons/icons.json';
import downloads from '../../../public/downloads.json';

const title = '百智办公 APP';
const description = '下载或在手机 App 中打开百智办公。';

const downloadLinks = {
  android: downloads.android || '/#clients',
  ios: downloads.ios || '/#clients',
  harmony: downloads.harmony || '/#clients',
};

const platformIcons = {
  android: hugeicons.icons['android'].body,
  ios: hugeicons.icons['apple-01'].body,
  harmony: hugeicons.icons['computer-terminal-01'].body,
};
---

<BaseLayout
  title={title}
  description={description}
  pathname="/app-link/scan/"
  robots="noindex,nofollow"
  bodyClass="page-app-link"
  showFooter={false}
>
  <main id="main-content" class="app-link-page">
    <section class="app-link-card" aria-labelledby="app-link-title">
      <img class="app-link-logo" src={`${import.meta.env.BASE_URL}monkeyai-logo.png`} width="72" height="72" alt="" />
      <h1 id="app-link-title">百智办公 APP</h1>
      <p class="app-link-description">点击下载 APP，登录后即可在手机端随时远程接管电脑上的任务</p>

      <div class="app-link-downloads" aria-label="下载百智办公 App">
        <a class="app-link-download" data-app-link-platform="android" href={downloadLinks.android} hidden>
          <svg class="app-link-download-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor" set:html={platformIcons.android} />
          <span>下载 Android APK</span>
        </a>
        <a class="app-link-download" data-app-link-platform="ios" href={downloadLinks.ios} hidden>
          <svg class="app-link-download-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor" set:html={platformIcons.ios} />
          <span>从 AppStore 安装</span>
        </a>
        <a class="app-link-download" data-app-link-platform="harmony" href={downloadLinks.harmony} hidden>
          <svg class="app-link-download-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor" set:html={platformIcons.harmony} />
          <span>从 华为应用市场 安装</span>
        </a>
      </div>

      <div class="app-link-divider" role="presentation"></div>

      <p class="app-link-open-hint">已安装 APP 但没有自动打开？请点击：</p>
      <a class="app-link-open" data-app-link-open href="monkeyai-mobile://pair/scan">打开 APP</a>
    </section>
  </main>
</BaseLayout>

<script>
  import {
    appLinkOpenUrl,
    platformFromUserAgent,
    visibleDownloadPlatforms,
  } from '../../lib/app-link-fallback';

  const platform = platformFromUserAgent(navigator.userAgent);
  const open = document.querySelector<HTMLAnchorElement>('[data-app-link-open]');
  if (open) open.href = appLinkOpenUrl(window.location.search);

  const visible = new Set(visibleDownloadPlatforms(platform));
  const downloadButtons = document.querySelectorAll<HTMLAnchorElement>('[data-app-link-platform]');
  for (const button of downloadButtons) {
    const item = button.dataset.appLinkPlatform;
    if (item === 'android' || item === 'ios' || item === 'harmony') {
      button.hidden = !visible.has(item);
    }
  }
</script>

<style>
  .app-link-page {
    display: flex;
    justify-content: center;
    padding: 32px 20px 80px;
  }

  .app-link-card {
    width: min(100%, 420px);
    padding: 32px 24px 28px;
    border: 1px solid var(--studio-line);
    border-radius: 20px;
    background: var(--studio-surface);
    box-shadow: 0 24px 80px color-mix(in srgb, var(--studio-text) 8%, transparent);
    text-align: center;
  }

  .app-link-logo {
    display: block;
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    border-radius: 50%;
  }

  .app-link-card h1 {
    margin: 0 0 14px;
    font-size: 28px;
    line-height: 1.3;
    font-weight: var(--weight-heading);
  }

  .app-link-description {
    margin: 0 0 24px;
    color: var(--studio-subtle);
    font-size: var(--type-body);
    line-height: var(--leading-body);
  }

  .app-link-downloads {
    display: grid;
    gap: 12px;
  }

  .app-link-download {
    display: flex;
    width: 100%;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 20px;
    border: 1px solid var(--green);
    border-radius: 999px;
    background: var(--green);
    color: #fff;
    font-size: var(--type-body);
    font-weight: var(--weight-heading);
    text-decoration: none;
    transition: background 160ms ease, border-color 160ms ease;
  }

  .app-link-download:hover {
    border-color: color-mix(in srgb, var(--green) 85%, #000);
    background: color-mix(in srgb, var(--green) 85%, #000);
  }

  .app-link-download[hidden] {
    display: none;
  }

  .app-link-download-icon {
    flex: none;
  }

  .app-link-divider {
    margin: 24px 0 18px;
    border-top: 1px solid var(--studio-line);
  }

  .app-link-open-hint {
    margin: 0 0 16px;
    color: var(--studio-subtle);
    font-size: var(--type-body);
    line-height: var(--leading-body);
  }

  .app-link-open {
    display: flex;
    width: 100%;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--studio-line);
    border-radius: 999px;
    background: var(--studio-surface);
    color: var(--studio-text);
    font-size: var(--type-body);
    font-weight: var(--weight-heading);
    text-decoration: none;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .app-link-open:hover {
    border-color: var(--green);
    color: var(--green);
  }

  @media (max-width: 520px) {
    .app-link-page { padding: 32px 24px 64px; }
    .app-link-card { padding: 32px 20px 24px; }
    .app-link-card h1 { font-size: 26px; }
  }
</style>
