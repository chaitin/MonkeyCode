---
import { HeaderActions } from './HeaderActions';
---

<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href={import.meta.env.BASE_URL} aria-label="百智办公 官网首页">
      <img class="header-brand-icon" src={`${import.meta.env.BASE_URL}monkeyai-logo.png`} width="30" height="30" alt="" />
      <span>百智办公</span>
    </a>
    <nav class="site-section-nav" aria-label="网站导航"><a href="https://monkeyai.docs.baizhi.cloud/" target="_blank" rel="noopener noreferrer">帮助文档</a></nav>
    <HeaderActions client:load />
  </div>
</header>
