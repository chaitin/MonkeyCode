POSTGRES_PASSWORD=change-this-database-password
MONKEYAI_INITIAL_ADMIN_EMAIL=admin@example.com
MONKEYAI_INITIAL_ADMIN_PASSWORD=change-this-admin-password

# 修改对外端口时，同时修改下面两个地址。
# MONKEYAI_ADMIN_PORT=8080
# MONKEYAI_PUBLIC_URL=http://localhost:8080
# MONKEYAI_ADMIN_URL=http://localhost:8080

# RustFS 凭据，Compose 默认同时用于后端启动时创建 Bucket 和读写资源。
RUSTFS_ACCESS_KEY=change-this-rustfs-admin-key
RUSTFS_SECRET_KEY=change-this-rustfs-admin-secret
# 如需独立应用凭据，需具备资源 Bucket 的访问权限；首次建桶还需 s3:CreateBucket。
# MONKEYAI_S3_ACCESS_KEY=your-resource-app-key
# MONKEYAI_S3_SECRET_KEY=your-resource-app-secret
# MONKEYAI_S3_BUCKET=monkeyai-resources
# MONKEYAI_S3_REGION=us-east-1
# MONKEYAI_MCP_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16

# 远程计费使用服务端 mTLS。环境、应用 ID 和证书须由百智云分配后填写。
# BAIZHIYUN_ENV=dev 或 prod
# BAIZHIYUN_APP_ID=
# MONKEYAI_WALLET_CERT_DIR=
